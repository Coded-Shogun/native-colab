# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/native_colab
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# JWT Authentication
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8080"]
CORS_ALLOW_CREDENTIALS=true

# API Configuration
API_V1_PREFIX=/api
PROJECT_NAME=Native Colab
VERSION=1.0.0
DEBUG=true

# Redis Configuration (optional, for caching)
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false

# File Storage (S3/MinIO)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=native-colab
S3_REGION=us-east-1
S3_USE_SSL=false

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@nativecolab.com
SMTP_FROM_NAME=Native Colab
SMTP_TLS=true

# Socket.io Configuration
SOCKET_URL=http://localhost:8000
SOCKET_PATH=/socket.io
SOCKET_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# WebRTC Configuration
WEBRTC_STUN_SERVERS=["stun:stun.l.google.com:19302","stun:stun1.l.google.com:19302"]
WEBRTC_TURN_SERVER=turn:your-turn-server.com:3478
WEBRTC_TURN_USERNAME=username
WEBRTC_TURN_PASSWORD=password

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=logs/app.log

# Celery (Task Queue) - Optional
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Monitoring - Optional
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Application
MAX_UPLOAD_SIZE=104857600  # 100MB in bytes
ALLOWED_FILE_TYPES=["pdf","doc","docx","xls","xlsx","ppt","pptx","txt","csv","png","jpg","jpeg","gif","svg","zip"]
SESSION_TIMEOUT_MINUTES=1440  # 24 hours

# Webhooks
WEBHOOK_MAX_RETRIES=3
WEBHOOK_RETRY_DELAY_SECONDS=300  # 5 minutes
WEBHOOK_TIMEOUT_SECONDS=30

# Search
SEARCH_RESULTS_PER_PAGE=20
SEARCH_MAX_RESULTS=100

# Analytics
ANALYTICS_ENABLED=true
ANALYTICS_BATCH_SIZE=100
ANALYTICS_FLUSH_INTERVAL_SECONDS=60
